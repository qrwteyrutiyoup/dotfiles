" ============================================================================
" Vim-plug Plugin Manager
" ============================================================================
" Install vim-plug if not already installed
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

call plug#begin('~/.vim/plugged')

" Essential plugins only
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-fugitive'

" Color schemes
Plug 'rafi/awesome-vim-colorschemes'

call plug#end()

" ============================================================================
" General Settings
" ============================================================================
set nocompatible
filetype plugin indent on
syntax on

set background=dark
set mouse=a
set cursorline
set ruler
set history=10000
set switchbuf=useopen
set clipboard=unnamedplus
set wrapmargin=8

" Line numbers
set number

" ============================================================================
" Indentation
" ============================================================================
set tabstop=4           " Size of a hard tabstop
set shiftwidth=4        " Size of an indent
set softtabstop=4       " Combination of spaces and tabs
set smarttab            " Make tab insert indents at beginning of line
set expandtab           " Always use spaces instead of tabs
set listchars=tab:\ \ ,trail:.

" Enforce tab settings for all filetypes (prevent ftplugin overrides)
augroup IndentSettings
    autocmd!
    autocmd FileType * setlocal tabstop=4 shiftwidth=4 softtabstop=4 expandtab
    autocmd BufRead,BufNewFile * setlocal tabstop=4 shiftwidth=4 softtabstop=4 expandtab
augroup END

" ============================================================================
" Backup and Swap Files
" ============================================================================
set nobackup
set nowritebackup
set noswapfile

" ============================================================================
" Color Scheme
" ============================================================================
if (&t_Co == 256)
    colorscheme termschool
endif

" Highlight trailing whitespace
highlight ExtraWhitespace ctermbg=darkred guibg=darkred
match ExtraWhitespace /\s\+$/

" Disable Background Color Erase (BCE) for tmux/screen compatibility
if &term =~ '256color'
    set t_ut=
endif

" ============================================================================
" Tmux Integration
" ============================================================================
if exists('$TMUX')
    function! TmuxOrSplitSwitch(wincmd, tmuxdir)
        let previous_winnr = winnr()
        execute "wincmd " . a:wincmd
        if previous_winnr == winnr()
            execute "silent !sh -c 'sleep 0.01; tmux select-pane -" . a:tmuxdir . "' &"
            redraw!
        endif
    endfunction

    let previous_title = substitute(system("tmux display-message -p '#{pane_title}'"), '\n', '', '')
    let &t_ti = "\<Esc>]2;vim\<Esc>\\" . &t_ti
    let &t_te = "\<Esc>]2;". previous_title . "\<Esc>\\" . &t_te

    nnoremap <silent> <C-h> :call TmuxOrSplitSwitch('h', 'L')<cr>
    nnoremap <silent> <C-j> :call TmuxOrSplitSwitch('j', 'D')<cr>
    nnoremap <silent> <C-k> :call TmuxOrSplitSwitch('k', 'U')<cr>
    nnoremap <silent> <C-l> :call TmuxOrSplitSwitch('l', 'R')<cr>
else
    map <C-h> <C-w>h
    map <C-j> <C-w>j
    map <C-k> <C-w>k
    map <C-l> <C-w>l
endif

" ============================================================================
" Custom Commands
" ============================================================================
" Strip trailing whitespace
command! Strip let _s=@/<Bar>:%s/\s\+$//e<Bar>:let @/=_s<Bar>:nohl

" ============================================================================
" Filetype Settings
" ============================================================================
if has("autocmd")
    autocmd BufNewFile,BufRead *.pro,*.pri set filetype=qmake
    autocmd BufNewFile,BufRead *.qml,*.qmlproject set filetype=qml
endif
