# Common shell config sourced by both .bashrc and .zshrc
# Handles Linux/macOS differences via OS detection.

# Detect OS ($OSTYPE is set by bash and zsh — no subprocess needed)
case "$OSTYPE" in
  darwin*) _OS=macos ;;
  *)       _OS=linux ;;
esac

__git_ps1()
{
  local b="$(git symbolic-ref HEAD 2>/dev/null)";
  if [ -n "$b" ]; then
    printf " (%s)" "${b##refs/heads/}";
  fi
}

_set_dircolors()
{
  local cmd
  if command -v dircolors >/dev/null 2>&1; then
    cmd=dircolors
  elif command -v gdircolors >/dev/null 2>&1; then
    cmd=gdircolors
  else
    return 0
  fi
  local DIRCOLORS=~/.dircolors
  [ -r "$DIRCOLORS" ] && eval $($cmd "$DIRCOLORS")
}

_set_dircolors_fast()
{
  local cache=~/.cache/dircolors.cache
  local src=~/.dircolors
  [ -r "$src" ] || return 0
  if [ ! -f "$cache" ] || [ "$src" -nt "$cache" ]; then
    local cmd
    if command -v dircolors >/dev/null 2>&1; then
      cmd=dircolors
    elif command -v gdircolors >/dev/null 2>&1; then
      cmd=gdircolors
    else
      return 0
    fi
    mkdir -p ~/.cache
    $cmd "$src" > "$cache"
  fi
  eval "$(< "$cache")"
}

_set_default_aliases_and_exports()
{
  # colorful ls aliases (macOS vs Linux)
  if [ "$_OS" = "macos" ]; then
    if command -v gls >/dev/null 2>&1; then
      alias ls="gls --color"
      alias l="gls -laFhrt --color"
      alias ll="gls -laFh --color"
    else
      alias ls="ls -G"
      alias l="ls -laFhrtG"
      alias ll="ls -laFhG"
    fi
  else
    alias ls="ls --color"
    alias l="ls -laFhrt --color"
    alias ll="ls -laFh --color"
  fi

  # it's better to be safer than sorry
  alias cp="cp -i"
  alias mv="mv -i"
  alias rm="rm -i"

  # making sure we have something usable when needed
  export VISUAL=vim
  export EDITOR=$VISUAL

  # user-defined bin path to drop custom executables
  export PATH=~/bin:$PATH

  # nicer terminal colors, if available
  if infocmp xterm-256color >/dev/null 2>&1; then export TERM=xterm-256color; fi
}

_set_default_aliases_and_exports_fast()
{
  if [ "$_OS" = "macos" ]; then
    if command -v gls >/dev/null 2>&1; then
      alias ls="gls --color"
      alias l="gls -laFhrt --color"
      alias ll="gls -laFh --color"
    else
      alias ls="ls -G"
      alias l="ls -laFhrtG"
      alias ll="ls -laFhG"
    fi
  else
    alias ls="ls --color"
    alias l="ls -laFhrt --color"
    alias ll="ls -laFh --color"
  fi

  alias cp="cp -i"
  alias mv="mv -i"
  alias rm="rm -i"

  export VISUAL=vim
  export EDITOR=$VISUAL
  export PATH=~/bin:$PATH
}

_set_keychain()
{
  if ! command -v keychain >/dev/null; then
    return 0
  fi

  if [ -n "$TERM" ]; then
    for k in id_rsa qrwteyrutiyoup-gitlab; do
      [ -r ~/.ssh/"${k}" ] && eval $(keychain -q --nogui --ignore-missing --eval "${k}")
    done
  fi
  export GPG_TTY="$(tty)"
  if [ "$_OS" = "macos" ]; then
    if ! pgrep -U "$USER" gpg-agent >/dev/null 2>&1; then
      eval "$(gpg-agent --daemon 2>/dev/null)"
    fi
  else
    if [ "$(ps -U "$USER" -o ucomm | grep gpg-agent | grep -v grep | wc -l)" -eq 0 ]; then
      eval "$(gpg-agent --daemon 2>/dev/null)"
    fi
  fi
}

_find_ykcs11()
{
  local lib
  for lib in \
    /opt/homebrew/lib/libykcs11.dylib \
    /usr/local/lib/libykcs11.dylib \
    /usr/lib/x86_64-linux-gnu/libykcs11.so \
    /usr/lib64/libykcs11.so \
    /usr/lib/libykcs11.so; do
    if [ -f "$lib" ]; then
      echo "$lib"
      return 0
    fi
  done
  return 1
}

_ykcs11_allow()
{
  local lib="$1" libdir="${1%/*}" allow="${1%/*}/*"
  if [ -L "$lib" ]; then
    local real
    real="$(cd "$libdir" && \
            cd "$(dirname "$(readlink "$lib" 2>/dev/null)")" 2>/dev/null && \
            pwd)"
    [ -n "$real" ] && [ "$real" != "$libdir" ] && allow="${allow},${real}/*"
  fi
  echo "$allow"
}

# YubiKey PIV SSH agent — replaces keychain's agent with one that
# supports the -P whitelist needed for PKCS#11 on OpenSSH 10.x.
# Uses a fixed socket so all terminals share one agent.
_set_yubikey_piv_agent()
{
  local lib
  lib="$(_find_ykcs11)" || return 0
  local sock="$HOME/.ssh/agent/yubikey.sock"
  export SSH_AUTH_SOCK="$sock"
  if [ ! -S "$sock" ]; then
    rm -f "$sock"
    eval $(ssh-agent -s -a "$sock" -P "$(_ykcs11_allow "$lib")")
    ssh-add -s "$lib"
  fi
}

yk-ssh() {
  if ssh-add -L >/dev/null 2>&1; then
    echo "YubiKey already loaded."
    return 0
  fi
  local lib
  lib="$(_find_ykcs11)" || { echo "libykcs11 not found." >&2; return 1; }
  local sock="$HOME/.ssh/agent/yubikey.sock"
  rm -f "$sock"
  eval $(ssh-agent -s -a "$sock" -P "$(_ykcs11_allow "$lib")")
  export SSH_AUTH_SOCK="$sock"
  ssh-add -s "$lib"
}

sshrm() {
  if [ -z "${1}" ]; then
    return 1
  fi
  if [ "$_OS" = "macos" ]; then
    sed -i '' "/^${1}/d" ~/.ssh/known_hosts
  else
    sed -i "/^${1}/d" ~/.ssh/known_hosts
  fi
}

