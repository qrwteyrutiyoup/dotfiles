#!/usr/bin/env bash

# If not running interactively, do not do anything.
[[ $- != *i* ]] && return
[ -e /etc/profile ] && . /etc/profile

# Enable bash-completion
if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

# Source common shell config (shared with zsh)
[ -f ~/.shellrc ] && . ~/.shellrc

_set_ps1_fast()
{
  local termchar
  if [ "$EUID" -eq 0 ]; then termchar='#'; else termchar='$'; fi
  case "$TERM" in
    *-256color|*-256colour|alacritty*)
      local base0=$'\e[38;5;244m'
      local yellow=$'\e[38;5;136m'
      local blue=$'\e[38;5;33m'
      local cyan=$'\e[38;5;37m'
      ;;
    xterm*|screen*|tmux*|rxvt*|linux|vt100)
      local base0=$'\e[94m'
      local yellow=$'\e[33m'
      local blue=$'\e[34m'
      local cyan=$'\e[36m'
      ;;
    *)
      PS1="\u@\h:\w\$(__git_ps1)${termchar} "
      return
      ;;
  esac
  local bold=$'\e[1m'
  local reset=$'\e[0m'
  PS1="\[${bold}${cyan}\]\u\[${base0}\]@\[${cyan}\]\h\[${base0}\]:\[${blue}\]\w\[${base0}${yellow}\]\$(__git_ps1)\[${base0}\]${termchar} \[${reset}\]"
}

_set_default_aliases_and_exports_fast
_set_ps1_fast
_set_dircolors_fast
_set_yubikey_piv_agent
