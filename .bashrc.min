#!/usr/bin/env bash

# If not running interactively, do not do anything.
[[ $- != *i* ]] && return
[ -e /etc/profile ] && . /etc/profile

# Enable bash-completion
if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

# Source common shell config (shared with zsh)
[ -f ~/.shellrc ] && . ~/.shellrc

_ps1_terminator_char()
{
  if [ $(whoami) = "root" ]; then
    printf '#'
  else
    printf '$'
  fi
}

_set_ps1()
{
  if tput setaf 1 &> /dev/null; then
    tput sgr0
    if [[ $(tput colors) -ge 256 ]] 2>/dev/null; then
      BASE0=$(tput setaf 244)
      YELLOW=$(tput setaf 136)
      BLUE=$(tput setaf 33)
      CYAN=$(tput setaf 37)
    else
      BASE0=$(tput setaf 12)
      YELLOW=$(tput setaf 3)
      BLUE=$(tput setaf 4)
      CYAN=$(tput setaf 6)
    fi

    BOLD=$(tput bold)
    RESET=$(tput sgr0)
    export PS1="\[${BOLD}${CYAN}\]\u\[$BASE0\]@\[$CYAN\]\h\[$BASE0\]:\[$BLUE\]\w\[$BASE0\]\[$YELLOW\]\$(__git_ps1)\[$BASE0\]\$(_ps1_terminator_char) \[$RESET\]"
  else
    export PS1="\u@\h:\w$(__git_ps1)\$(_ps1_terminator_char) "
  fi
}

_set_default_aliases_and_exports
_set_ps1
_set_dircolors
_set_keychain

# Delete key for st
command -v tput >/dev/null 2>&1 && tput smkx 2>/dev/null

# vim:set ts=2 sw=2 et:
